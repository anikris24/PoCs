@* Tabs.razor *@
<div class="tabs-container">
    @* 1. The Header Row (Where all tab names are displayed) *@
    <div class="tabs-header">
        @foreach (var tab in TabList)
        {
            <button type="button" 
                    class="tab-link @(ActiveTab == tab ? "active" : "")" 
                    @onclick="() => SelectTab(tab)">
                @tab.Name
            </button>
        }
    </div>

    @* 2. The Visible Content Area *@
    <div class="tabs-content">
        @ActiveTab?.ChildContent
    </div>
</div>

@* 3. Hidden Registration Area *@
@* We render the ChildContent inside a hidden div so the Tab.razor 
   lifecycle methods run and register themselves to the list *@
<CascadingValue Value="this" IsFixed="true">
    <div style="display:none">
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter] public RenderFragment ChildContent { get; set; }
    
    public List<Tab> TabList = new();
    public Tab ActiveTab { get; private set; }

    public void AddTab(Tab tab)
    {
        if (!TabList.Contains(tab))
        {
            TabList.Add(tab);
            // Set the first tab as active by default
            if (ActiveTab == null) ActiveTab = tab;
            StateHasChanged();
        }
    }

    private void SelectTab(Tab tab)
    {
        ActiveTab = tab;
    }
}