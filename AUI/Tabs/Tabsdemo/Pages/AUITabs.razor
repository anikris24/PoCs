
@page "/aui-tabs";

@using System.ComponentModel;
@using System;

hello from tabs!

<Tabs ViewModel="@tabsViewModel"></Tabs>

<div class="display-area">
    @if (selectedType != null)
    {
        @* This renders the actual component based on the type *@
        <DynamicComponent Type="@selectedType" Parameters="@componentParameters" />
    }
</div>

@code {
    private ITabsViewModel tabsViewModel;
    private Type? selectedType;
    Dictionary<string, object> componentParameters = new();
    int contentIndex;
    public AUITabs()
    {
        var tabItems = new ObservableCollection<ITabItemViewModel>
            {
                CreateTabItem("1. Project Overview Tab"),
                CreateTabItem("2. Application Settings Tab"),
                CreateTabItem("3. Counter Settings Tab"),

            };

        tabsViewModel = new TabsViewModel(tabItems);
        tabsViewModel.PropertyChanged += SelectedTab_PropertyChanged;

    }

    private ITabItemViewModel CreateTabItem(string title)
    {
        var tabItem = new TabItemViewModel(title, tabsViewModel)
            {
                CanClose = true,
                TooltipViewModel = new TooltipViewModel(title, ElementPosition.TopCenter, 0, -10)
            };

        return tabItem;
    }


    private void SelectedTab_PropertyChanged(object sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(ITabsViewModel.SelectedItem))
        {
            Console.WriteLine("SelectedItem: " + tabsViewModel.SelectedItem.Text);
        }

        UpdateContentIndex();
        switch (contentIndex)
        {
            case 0:
                selectedType = typeof(QuickGridComp);
                break;

            case 1:
                selectedType = typeof(MudTablesComp);
                break;
            case 2:
                selectedType = typeof(CounterComp);
                break;

            default:
                break;
        }

        StateHasChanged();
    }

    private void UpdateContentIndex()
    {
        if (!tabsViewModel.TabItemViewModels.Any())
        {
            contentIndex = -1;
        }

        contentIndex = 0;
        foreach (var tabItem in tabsViewModel.TabItemViewModels)
        {
            if (tabsViewModel.SelectedItem == tabItem)
            {
                break;
            }
            ++contentIndex;
        }
    }
}